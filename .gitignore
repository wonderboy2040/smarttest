# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
app/.env

# Server runtime state & logs
app/server/data/*
!app/server/data/.gitkeep
**/server/data/logs/
*.log
**/*.log

# Bot-lab runtime state (candle store, virtual accounts, events) + exec heartbeat
# v20.8.2 FIX: user push 1ae24ae accidentally committed these runtime-mutated files —
# tracked-here means a permanently dirty tree + accidental re-commits every run
app/data/

# Build artifacts
# v21.0.1 FIX (Vision AI button "show nahi ho raha" ka root cause): dist/ pehle
# gitignored tha — fresh clone/pull pe frontend KABHI nahi aata tha, aur user ka
# purana (stale) dist serve hota rehta tha jab tak watchdog rebuild na kar deta.
# Ab app/dist repo me TRACKED hai — git pull = fresh frontend guaranteed.
# (build/ dir aj bhi ignored — sirf vite ka dist deliverable hai.)
!app/dist/
!app/dist/**
build/
**/build/

# ml-service / deploy artifacts (agar kahin build hue)
ml-service/dist/

# Test data & scratch dirs
.test-data*
**/.test-data*
coverage/
**/coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python cache (ml-service)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
